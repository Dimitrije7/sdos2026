{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dimitrije7/sdos2026/manifest/schemas/versions.schema.json",
  "title": "SDOS platform version manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "revision",
    "updated",
    "selection_rule",
    "section4",
    "inputs",
    "deferred"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "manifest_id": {"const": "sdos-platform-versions"},
    "revision": {"type": "integer", "minimum": 1},
    "updated": {"type": "string", "format": "date"},
    "selection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_cutoff", "description"],
      "properties": {
        "release_cutoff": {"type": "string", "format": "date"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "section4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Board image",
        "Linux",
        "DSP SDK",
        "C66x compiler",
        "C71x compiler",
        "Host build environment",
        "CI",
        "Development UX"
      ],
      "patternProperties": {
        ".*": {"$ref": "#/$defs/id_list"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "deferred": {
      "type": "array",
      "items": {"$ref": "#/$defs/deferred"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "id_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "https_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "state",
        "version",
        "license_matrix",
        "source",
        "integrity",
        "acquisition",
        "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "file",
            "git",
            "oci-image",
            "apt-snapshot",
            "pypi",
            "npm",
            "github-action",
            "contained",
            "runner-label"
          ]
        },
        "state": {
          "enum": ["candidate", "qualified", "semester-frozen", "superseded"]
        },
        "version": {"type": "string", "minLength": 1},
        "license_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact"],
          "properties": {
            "artifact": {"$ref": "#/$defs/id"},
            "component": {"type": "string", "minLength": 1}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": {"$ref": "#/$defs/https_url"},
            "file_name": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "minLength": 1},
            "published": {"type": "string", "format": "date"}
          }
        },
        "integrity": {"type": "object"},
        "acquisition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["allowed", "gated"]},
            "blocker_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^LIC-[0-9]{3}$"}
            }
          },
          "if": {"properties": {"status": {"const": "gated"}}},
          "then": {"required": ["blocker_ids"], "properties": {"blocker_ids": {"minItems": 1}}}
        },
        "evidence": {"$ref": "#/$defs/https_url"},
        "qualification_evidence": {"type": "string", "pattern": "^release/evidence/"},
        "superseded_by": {"$ref": "#/$defs/id"},
        "notes": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["file", "pypi"]}}},
          "then": {
            "required": ["source"],
            "properties": {
              "source": {"required": ["url", "file_name"]},
              "integrity": {
                "additionalProperties": false,
                "required": ["sha256"],
                "properties": {
                  "sha256": {"$ref": "#/$defs/sha256"},
                  "size": {"type": "integer", "minimum": 1},
                  "expanded_sha256": {"$ref": "#/$defs/sha256"},
                  "expanded_size": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "npm"}}},
          "then": {
            "properties": {
              "source": {"required": ["url", "file_name"]},
              "integrity": {
                "additionalProperties": false,
                "required": ["sha512_integrity"],
                "properties": {
                  "sha512_integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"enum": ["git", "github-action"]}}},
          "then": {
            "properties": {
              "source": {"required": ["url", "ref"]},
              "integrity": {
                "additionalProperties": false,
                "required": ["commit"],
                "properties": {"commit": {"$ref": "#/$defs/commit"}}
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "oci-image"}}},
          "then": {
            "properties": {
              "source": {"required": ["url", "ref"]},
              "integrity": {
                "additionalProperties": false,
                "required": ["index_digest", "platform_digests"],
                "properties": {
                  "index_digest": {"$ref": "#/$defs/oci_digest"},
                  "platform_digests": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {"pattern": "^linux/[a-z0-9]+(/v[0-9]+)?$"},
                    "additionalProperties": {"$ref": "#/$defs/oci_digest"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "apt-snapshot"}}},
          "then": {
            "properties": {
              "integrity": {
                "additionalProperties": false,
                "required": ["snapshot", "signing_key_fingerprint", "inrelease_sha256", "packages"],
                "properties": {
                  "snapshot": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
                  "signing_key_fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
                  "inrelease_sha256": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"$ref": "#/$defs/sha256"}
                  },
                  "packages": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "version", "suite", "file_name", "sha256", "matrix_component"],
                      "properties": {
                        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]+$"},
                        "version": {"type": "string", "minLength": 1},
                        "suite": {"type": "string", "minLength": 1},
                        "file_name": {"type": "string", "pattern": "\\.deb$"},
                        "sha256": {"$ref": "#/$defs/sha256"},
                        "matrix_component": {"type": ["string", "null"]}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "contained"}}},
          "then": {
            "properties": {
              "integrity": {
                "additionalProperties": false,
                "required": ["contained_in"],
                "properties": {
                  "contained_in": {"$ref": "#/$defs/id"},
                  "path": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "runner-label"}}},
          "then": {
            "properties": {
              "integrity": {
                "additionalProperties": false,
                "required": ["label", "image_version_evidence"],
                "properties": {
                  "label": {"type": "string", "pattern": "^ubuntu-[0-9]{2}\\.[0-9]{2}$"},
                  "image_version_evidence": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"state": {"enum": ["qualified", "semester-frozen"]}}},
          "then": {"required": ["qualification_evidence"]}
        },
        {
          "if": {"properties": {"state": {"const": "superseded"}}},
          "then": {"required": ["superseded_by"]}
        }
      ]
    },
    "deferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "reason", "owner"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "pattern": "^Task [0-9]{3}"}
      }
    }
  }
}
