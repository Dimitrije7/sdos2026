{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdos:schema:hardware-bom:1.0.0",
  "title": "SDOS reference hardware bill of materials",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bom_id",
    "revision",
    "updated",
    "applies_to",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "bom_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "soc", "course_release"],
      "properties": {
        "board": {
          "type": "string",
          "minLength": 1
        },
        "soc": {
          "type": "string",
          "minLength": 1
        },
        "course_release": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_station", "per_lab", "minimum_total"],
      "properties": {
        "per_station": {
          "type": "number",
          "minimum": 0
        },
        "per_lab": {
          "type": "number",
          "minimum": 0
        },
        "minimum_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "spares": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fraction_of_recommended", "minimum_total"],
      "properties": {
        "fraction_of_recommended": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scalar": {
      "type": ["string", "number", "integer", "boolean"]
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/scalar"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/scalar"
            }
          }
        ]
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "requirement_level",
        "description",
        "quantity",
        "technical_minimum",
        "recommended",
        "supported_examples",
        "acceptance_checks",
        "automatic_discovery",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "category": {
          "enum": [
            "board",
            "power_supply",
            "cooling",
            "storage",
            "card_reader",
            "uart",
            "ethernet",
            "recovery_media"
          ]
        },
        "requirement_level": {
          "enum": ["required", "recommended", "spare-only"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["technical_minimum", "recommended", "spares"],
          "properties": {
            "technical_minimum": {
              "$ref": "#/$defs/quantity"
            },
            "recommended": {
              "$ref": "#/$defs/quantity"
            },
            "spares": {
              "$ref": "#/$defs/spares"
            }
          }
        },
        "technical_minimum": {
          "$ref": "#/$defs/capabilities"
        },
        "recommended": {
          "$ref": "#/$defs/capabilities"
        },
        "supported_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manufacturer", "model", "url", "notes"],
            "properties": {
              "manufacturer": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "part_number": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "acceptance_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "method", "criterion"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]+$"
              },
              "method": {
                "enum": ["automatic", "manual", "both"]
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "automatic_discovery": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "source", "limitations"],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]+$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "url", "checked_on"],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "checked_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
