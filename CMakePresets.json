  "testPresets": [
    {
      "name": "host-gcc-debug",
      "configurePreset": "host-gcc-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-gcc-release",
      "configurePreset": "host-gcc-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-clang-debug",
      "configurePreset": "host-clang-debug",
      "output": {
